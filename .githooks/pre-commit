#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# Don't risk overwriting or mixing in existing unstaged changes.
if ! git diff --quiet; then
    echo "pre-commit: unstaged changes detected; commit aborted." >&2
    exit 1
fi

echo "Running formatter..."
./scripts/format

# Require review whenever formatting modifies tracked files.
if ! git diff --quiet; then
    echo >&2
    echo "pre-commit: formatting changed files; commit aborted." >&2
    git --no-pager diff --name-only >&2
    echo >&2
    echo "Review changes, run your build/tests, then stage and commit again." >&2
    exit 1
fi

echo "Formatting clean. Continuing commit."
