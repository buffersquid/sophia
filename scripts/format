#!/usr/bin/env bash
set -euo pipefail

die() {
    printf 'format-scheme: error: %s\n' "$*" >&2
    exit 1
}

# Check dependencies.
command -v guix >/dev/null 2>&1 ||
    die "Guix is not installed or not on PATH."

# Resolve the repository root, regardless of the caller's cwd.
repo_root="$(
    cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." &&
    pwd -P
)"
cd -- "$repo_root"

# Build the formatter once.
printf 'Building guile-schemefmt...\n'

if ! formatter_store="$(
    guix build -L "$repo_root/modules" guile-schemefmt
)"; then
    die "Failed to build guile-schemefmt."
fi

formatter="$formatter_store/bin/schemefmt"

[[ -x "$formatter" ]] ||
    die "Formatter not found or not executable: $formatter"

# Format every Scheme file, excluding Git repositories.
printf 'Formatting Scheme files...\n'

if ! find . \
    -type d -name .git -prune -o \
    -type f -name '*.scm' \
    -exec "$formatter" -w {} \;
then
    die "Formatting failed."
fi

printf 'Formatting complete.\n'
