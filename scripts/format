#!/usr/bin/env bash
set -euo pipefail

die() {
    printf 'format-scheme: error: %s\n' "$*" >&2
    exit 1
}

# Resolve the repository root, regardless of the caller's cwd.
repo_root="$(
    cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." &&
    pwd -P
)"
cd -- "$repo_root"

# Find or build the formatter.
if command -v guix >/dev/null 2>&1; then
    printf 'Building guile-schemefmt with Guix...\n'

    if ! formatter_store="$(
        guix build -L "$repo_root/modules" guile-schemefmt
    )"; then
        die "Failed to build guile-schemefmt with Guix."
    fi

    formatter="$formatter_store/bin/schemefmt"

elif command -v schemefmt >/dev/null 2>&1; then
    formatter="$(command -v schemefmt)"
    printf 'Using installed schemefmt: %s\n' "$formatter"

else
    cat >&2 <<'EOF'
format-scheme: error: no formatter found.

Neither Guix nor the schemefmt binary is available.

To fix this, either:
  - Install Guix so this script can build guile-schemefmt.
  - Install the schemefmt binary and ensure it is on your PATH.

Then rerun scripts/format.
EOF
    exit 1
fi

[[ -x "$formatter" ]] ||
    die "Formatter not found or not executable: $formatter"

# Format every Scheme file, excluding Git repositories.
printf 'Formatting Scheme files...\n'

mapfile -d '' -t scheme_files < <(
    find . \
        -type d -name .git -prune -o \
        -type f -name '*.scm' -print0
)

changed=()

for file in "${scheme_files[@]}"; do
    before=$(sha256sum < "$file") ||
        die "Failed to hash $file"

    "$formatter" -w "$file" ||
        die "Formatting failed: $file"

    after=$(sha256sum < "$file") ||
        die "Failed to hash $file"

    if [[ "$before" != "$after" ]]; then
        changed+=("$file")
    fi
done

if ((${#changed[@]})); then
    printf 'Formatted:\n'
    printf '  %s\n' "${changed[@]}"
else
    printf 'No files needed formatting.\n'
fi

printf 'Formatting complete.\n'
